cabal-version:      3.0
name:               conformance
version:            0.0.0.1

license:            MIT
author:             Raphael Meyer

category:           Language
build-type:         Simple

common warnings
    ghc-options: -Wall -Wextra -Werror

library harness
    import:         warnings

    exposed-modules:
        Annotations,
        Conformance,
        Runner

    build-depends:
        base,
        directory,
        filepath,
        hspec,
        process,
        text,
        transformers

    hs-source-dirs:   src
    default-language: Haskell2010

test-suite conformance-test
    import:           warnings
    main-is:          Main.hs

    build-depends:
        harness,
        base,
        hspec

    type: exitcode-stdio-1.0
    hs-source-dirs: app
    default-language: Haskell2010

test-suite harness-test
    import:     warnings
    main-is:    Spec.hs

    other-modules:
        AnnotationsSpec

    build-depends:
        base,
        extra,
        hspec,
        harness

    build-tool-depends:
        hspec-discover:hspec-discover

    type: exitcode-stdio-1.0
    hs-source-dirs: test
    default-language:Haskell2010

test-suite conformance-style
    type:             exitcode-stdio-1.0
    main-is:          Style.hs
    hs-source-dirs:   tools
    default-language: Haskell2010
    build-depends:    base
    build-tool-depends:
        ormolu:ormolu,
        hlint:hlint
